{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ],
  "functions": {
    "api/advisor-video.js": {
      "maxDuration": 60
    },
    "api/upload-video.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
